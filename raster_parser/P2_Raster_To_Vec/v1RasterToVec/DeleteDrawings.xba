<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="RemoveDrawings" script:language="StarBasic">Sub DeleteDrawingsAndExportPDF
    Dim oDoc As Object
    Dim oDrawPages As Object
    Dim oPage As Object
    Dim oShape As Object
    
    Dim i As Long, j As Long, k As Long
    Dim extPos As Long
    
    Dim sShapeType As String
    Dim origWidth As Long, origHeight As Long
    Dim shapeWidth As Long, shapeHeight As Long
    
    Dim sDocURL As String
    Dim sNewURL As String
    Dim oExportArgs(0) As New com.sun.star.beans.PropertyValue
    
    &apos; Set up a global error handler so LibreOffice still closes if something breaks
    On Error GoTo CleanExit
    
    oDoc = ThisComponent
    
    &apos; Check if the active document is a Draw document
    If Not oDoc.SupportsService(&quot;com.sun.star.drawing.GenericDrawingDocument&quot;) Then
        GoTo CleanExit
    End If
    
    &apos; Get the URL (file path) of the currently opened PDF
    sDocURL = oDoc.getURL()
    If sDocURL = &quot;&quot; Then
        GoTo CleanExit
    End If
    
    oDrawPages = oDoc.getDrawPages()
    
    &apos; --- PART 1: DELETE TEXT AND DRAWINGS ---
    For i = 0 To oDrawPages.getCount() - 1
        oPage = oDrawPages.getByIndex(i)
        
        origWidth = oPage.Width
        origHeight = oPage.Height
        
        For j = oPage.getCount() - 1 To 0 Step -1
            oShape = oPage.getByIndex(j)
            sShapeType = oShape.ShapeType
            
            shapeWidth = oShape.Size.Width
            shapeHeight = oShape.Size.Height
            
            If sShapeType &lt;&gt; &quot;com.sun.star.drawing.GraphicObjectShape&quot; And _
               sShapeType &lt;&gt; &quot;com.sun.star.drawing.OLE2Shape&quot; Then
               
                &apos; Ignore the background canvas (matches page size)
                If Abs(shapeWidth - origWidth) &lt; 500 And Abs(shapeHeight - origHeight) &lt; 500 Then
                    &apos; Keep it
                Else
                    oPage.remove(oShape)
                End If
            End If
        Next j
        
        &apos; Enforce the original page dimensions
        oPage.Width = origWidth
        oPage.Height = origHeight
    Next i
    
    &apos; --- PART 2: EXPORT TO NEW PDF ---
    extPos = 0
    For k = Len(sDocURL) To 1 Step -1
        If Mid(sDocURL, k, 1) = &quot;.&quot; Then
            extPos = k
            Exit For
        End If
    Next k
    
    If extPos &gt; 0 Then
        sNewURL = Left(sDocURL, extPos - 1) &amp; &quot;_cleared.pdf&quot;
    Else
        sNewURL = sDocURL &amp; &quot;_cleared.pdf&quot;
    End If
    
    oExportArgs(0).Name = &quot;FilterName&quot;
    oExportArgs(0).Value = &quot;draw_pdf_Export&quot;
    
    &apos; Export the file
    oDoc.storeToURL(sNewURL, oExportArgs)
    
CleanExit:
    &apos; --- PART 3: SILENTLY CLOSE AND EXIT ---
    On Error Resume Next &apos; Prevent errors during shutdown sequence
    
    If Not IsNull(oDoc) Then
        &apos; Tell LibreOffice the document is &quot;unmodified&quot; so it doesn&apos;t prompt to save
        oDoc.setModified(False)
        &apos; Close the document
        oDoc.close(True)
    End If
    
    &apos; Force LibreOffice to quit completely
    StarDesktop.terminate()
End Sub
</script:module>
